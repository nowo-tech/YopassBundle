{#- Demo masthead shared by the admin and guest layouts (REQ-DEMO-014): UiKit header, brand and menu classes. -#}
{% set _route = app.request.attributes.get('_route')|default('') %}
<header class="nowo-ui-header" data-testid="demo-masthead">
    <a class="nowo-ui-brand" href="{{ path('nowo_yopass_index') }}">Yopass Bundle demo</a>
    <nav class="nowo-ui-menu" aria-label="Demo">
        <a class="nowo-ui-link" href="{{ path('nowo_yopass_index') }}"{% if _route == 'nowo_yopass_index' %} aria-current="page"{% endif %}>My shares</a>
    </nav>
    <div class="nowo-ui-header__end">
        <span class="nowo-ui-badge nowo-ui-badge--neutral">Symfony 8 · FrankenPHP</span>
    </div>
</header>
