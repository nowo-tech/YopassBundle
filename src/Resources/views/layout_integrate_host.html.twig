{#
    Deprecated since 1.10 (removed in 2.0): 1.x bridge for host layout integration (REQ-UI-001), mapping the host
    `body` block to `nowo_ui_content`. Since 1.10 the pages are on the UiKit page contract (REQ-UI-003): point
    nowo_ui_kit.layouts.admin / guest at your layout (extend @NowoUiKit/layout/admin.html.twig or use
    @NowoUiKit/layout/_bridge.html.twig) instead. When web_ui.layout_template still points here, YopassPages wraps it in
    the deprecated @NowoYopassBundle/_legacy_layout.html.twig bridge, so the pages keep rendering.
#}
{% extends 'base.html.twig' %}

{% block body %}
    {% block nowo_ui_content %}{% endblock %}
{% endblock %}

{# Map host stylesheets/javascripts if your layout uses different block names. #}
{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
