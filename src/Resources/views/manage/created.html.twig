{% extends nowo_yopass_layout_template %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

{% block title %}{{ 'yopass.result.title'|trans({}, 'NowoYopassBundle') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/yopass.js', 'nowo_yopass') }}"></script>
{% endblock %}

{% block body %}
    <div class="{{ ui.page_header(nowo_yopass_css_framework|default('tabler')) }}">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="page-title">{{ 'yopass.result.title'|trans({}, 'NowoYopassBundle') }}</h1>
            </div>
            <div class="col-auto">
                <a href="{{ path(routes.manage.name) }}" class="{{ ui.btn('secondary', null, nowo_yopass_css_framework|default('tabler')) }}">{{ 'yopass.back'|trans({}, 'NowoYopassBundle') }}</a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="{{ ui.card(nowo_yopass_css_framework|default('tabler')) }}"
                 data-controller="nowo-yopass-created"
                 data-nowo-yopass-created-share-id-value="{{ share.id }}"
                 data-nowo-yopass-created-public-path-value="{{ public_path }}"
                 data-nowo-yopass-created-show-remember-notice-value="{{ sharing_options.show_remember_notice ? 'true' : 'false' }}"
                 data-nowo-yopass-created-allow-embed-in-url-value="{{ sharing_options.allow_embed_in_url|default(false) ? 'true' : 'false' }}"
                 data-nowo-yopass-created-key-unavailable-message-value="{{ 'yopass.result.key_unavailable'|trans({}, 'NowoYopassBundle')|e('html_attr') }}">
                <div class="card-body">
                    <div class="alert alert-danger d-none" data-nowo-yopass-created-target="error"></div>

                    <div data-nowo-yopass-created-target="content">
                        <div class="alert alert-warning{% if not sharing_options.show_remember_notice %} d-none{% endif %} mb-4" data-nowo-yopass-created-target="rememberNotice">
                            <strong>{{ 'yopass.result.remember'|trans({}, 'NowoYopassBundle') }}:</strong>
                            {{ 'yopass.result.remember_text'|trans({}, 'NowoYopassBundle') }}
                        </div>

                        {# REQ-TWIG-005: read-only result fields (ShareCreatedLinksType, filled by the browser, never submitted). #}
                        {{ form_start(links_form, { attr: { autocomplete: 'off', onsubmit: 'return false;' } }) }}
                        {#
                            Security (REQ-SEC-004 M1): the one-click link embeds the key in the URL fragment (#decrypt_key=…),
                            which the browser never sends to the server. It is rendered only when sharing.allow_embed_in_url
                            is true, first when sharing.default_embed_in_url is true, otherwise below the short link + key.
                        #}
                        {% set embed_allowed = sharing_options.allow_embed_in_url|default(false) and links_form.oneClickLink is defined %}
                        {% set embed_first = embed_allowed and sharing_options.default_embed_in_url|default(false) %}
                        {% if embed_first %}{{ block('yopass_one_click_field') }}{% endif %}

                        <label class="form-label" for="yopass-created-short">{{ 'yopass.result.short'|trans({}, 'NowoYopassBundle') }}</label>
                        <p class="text-secondary small mb-1">{{ 'yopass.result.short_help'|trans({}, 'NowoYopassBundle') }}</p>
                        <div class="input-group mb-4">
                            {{ form_widget(links_form.shortLink) }}
                            <button type="button" class="{{ ui.btn('secondary', null, nowo_yopass_css_framework|default('tabler')) }}" data-action="nowo-yopass-created#copyShortLink">{{ 'yopass.link.copy'|trans({}, 'NowoYopassBundle') }}</button>
                        </div>

                        <label class="form-label" for="yopass-created-key">{{ 'yopass.result.decryption_key'|trans({}, 'NowoYopassBundle') }}</label>
                        <p class="text-secondary small mb-1">{{ 'yopass.result.decryption_key_help'|trans({}, 'NowoYopassBundle') }}</p>
                        <div class="input-group mb-4">
                            {{ form_widget(links_form.key) }}
                            <button type="button" class="{{ ui.btn('secondary', null, nowo_yopass_css_framework|default('tabler')) }}" data-action="nowo-yopass-created#copyKey">{{ 'yopass.link.copy'|trans({}, 'NowoYopassBundle') }}</button>
                        </div>

                        {% if embed_allowed and not embed_first %}{{ block('yopass_one_click_field') }}{% endif %}

                        {% for child in links_form %}
                            {% if not child.rendered %}
                                {{ form_row(child) }}
                            {% endif %}
                        {% endfor %}
                        {{ form_end(links_form) }}

                        <a href="{{ path(routes.manage.name) }}" class="{{ ui.btn('primary', null, nowo_yopass_css_framework|default('tabler')) }} w-100">
                            {{ 'yopass.result.create_another'|trans({}, 'NowoYopassBundle') }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block yopass_one_click_field %}
    <label class="form-label" for="yopass-created-one-click">{{ 'yopass.result.one_click'|trans({}, 'NowoYopassBundle') }}</label>
    <p class="text-secondary small mb-1">{{ 'yopass.result.one_click_help'|trans({}, 'NowoYopassBundle') }}</p>
    <div class="input-group mb-4">
        {{ form_widget(links_form.oneClickLink) }}
        <button type="button" class="{{ ui.btn('secondary', null, nowo_yopass_css_framework|default('tabler')) }}" data-action="nowo-yopass-created#copyOneClickLink">{{ 'yopass.link.copy'|trans({}, 'NowoYopassBundle') }}</button>
    </div>
{% endblock %}
