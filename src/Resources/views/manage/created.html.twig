{#
  Share created page (REQ-UI-003): UiKit show scaffold. Variable: page (View\ShowPage from
  YopassPageFactory::createdPage(): header yopass.result.title with the back link and the "Create another share"
  action). Data block filled: nowo_ui_show_sections (the links card: short link, decryption key and — only when
  sharing.allow_embed_in_url — the one-click link, built in the browser by the nowo-yopass-created controller from the
  key kept in sessionStorage; the key never reaches the server). nowo_ui_scripts stacks the bundle script.
  Other variables: share, public_path, routes, sharing_options, dashboard_route, links_form (ShareCreatedLinksType).
#}
{% extends '@NowoUiKit/page/show.html.twig' %}
{% trans_default_domain 'NowoYopassBundle' %}

{% block nowo_ui_show_sections %}
    {% set _b = page.bundle %}
    <section class="{{ nowo_ui_class('section', _b) }} {{ nowo_ui_class('card', _b) }}" data-nowo-ui-region="section"{{ nowo_ui_attrs('section', _b) }}
             data-controller="nowo-yopass-created"
             data-nowo-yopass-created-share-id-value="{{ share.id }}"
             data-nowo-yopass-created-public-path-value="{{ public_path }}"
             data-nowo-yopass-created-show-remember-notice-value="{{ sharing_options.show_remember_notice ? 'true' : 'false' }}"
             data-nowo-yopass-created-allow-embed-in-url-value="{{ sharing_options.allow_embed_in_url|default(false) ? 'true' : 'false' }}"
             data-nowo-yopass-created-key-unavailable-message-value="{{ 'yopass.result.key_unavailable'|trans }}">
        <div class="{{ nowo_ui_class('card_body', _b) }}">
            <div class="{{ nowo_ui_class('flash_error', _b) }}" role="alert" hidden data-nowo-yopass-created-target="error"></div>

            <div data-nowo-yopass-created-target="content">
                <div class="{{ nowo_ui_class('flash_warning', _b) }}" role="status"{% if not sharing_options.show_remember_notice %} hidden{% endif %} data-nowo-yopass-created-target="rememberNotice">
                    <strong>{{ 'yopass.result.remember'|trans }}:</strong>
                    {{ 'yopass.result.remember_text'|trans }}
                </div>

                {# REQ-TWIG-005: read-only result fields (ShareCreatedLinksType, filled by the browser, never submitted). #}
                {{ form_start(links_form, {attr: {
                    class: nowo_ui_class('form', _b),
                    autocomplete: 'off',
                    'data-action': 'submit->nowo-yopass-created#preventSubmit',
                }}) }}
                {#
                    Security (REQ-SEC-004 M1): the one-click link embeds the key in the URL fragment (#decrypt_key=…),
                    which the browser never sends to the server. It is rendered only when sharing.allow_embed_in_url
                    is true, first when sharing.default_embed_in_url is true, otherwise below the short link + key.
                #}
                {% set embed_allowed = sharing_options.allow_embed_in_url|default(false) and links_form.oneClickLink is defined %}
                {% set embed_first = embed_allowed and sharing_options.default_embed_in_url|default(false) %}
                {% if embed_first %}{{ block('yopass_one_click_field') }}{% endif %}

                {{ block('yopass_copy_field_short') }}
                {{ block('yopass_copy_field_key') }}

                {% if embed_allowed and not embed_first %}{{ block('yopass_one_click_field') }}{% endif %}

                {% for child in links_form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                {{ form_end(links_form) }}
            </div>
        </div>
    </section>
{% endblock %}

{% block yopass_copy_field_short %}
    {% set _b = page.bundle %}
    <div class="{{ nowo_ui_class('form_row', _b) }}">
        <label class="{{ nowo_ui_class('form_label', _b) }}" for="yopass-created-short">{{ 'yopass.result.short'|trans }}</label>
        <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'yopass.result.short_help'|trans }}</p>
        <div class="{{ nowo_ui_class('toolbar', _b) }} nowo-yopass-copy-field">
            {{ form_widget(links_form.shortLink) }}
            <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-action="nowo-yopass-created#copyShortLink">{{ 'yopass.link.copy'|trans }}</button>
        </div>
    </div>
{% endblock %}

{% block yopass_copy_field_key %}
    {% set _b = page.bundle %}
    <div class="{{ nowo_ui_class('form_row', _b) }}">
        <label class="{{ nowo_ui_class('form_label', _b) }}" for="yopass-created-key">{{ 'yopass.result.decryption_key'|trans }}</label>
        <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'yopass.result.decryption_key_help'|trans }}</p>
        <div class="{{ nowo_ui_class('toolbar', _b) }} nowo-yopass-copy-field">
            {{ form_widget(links_form.key) }}
            <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-action="nowo-yopass-created#copyKey">{{ 'yopass.link.copy'|trans }}</button>
        </div>
    </div>
{% endblock %}

{% block yopass_one_click_field %}
    {% set _b = page.bundle %}
    <div class="{{ nowo_ui_class('form_row', _b) }}">
        <label class="{{ nowo_ui_class('form_label', _b) }}" for="yopass-created-one-click">{{ 'yopass.result.one_click'|trans }}</label>
        <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'yopass.result.one_click_help'|trans }}</p>
        <div class="{{ nowo_ui_class('toolbar', _b) }} nowo-yopass-copy-field">
            {{ form_widget(links_form.oneClickLink) }}
            <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-action="nowo-yopass-created#copyOneClickLink">{{ 'yopass.link.copy'|trans }}</button>
        </div>
    </div>
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/yopass.js', 'nowo_yopass') }}"></script>
{% endblock %}
