{#
  Preview / extend dialog of the manage page (1.13 layout: status badge next to the title; key / password input group
  with the only primary button "Show content"; revealed text in a monospace block with Copy; public link with a copy icon
  button and a toast; extend in its own section with a 2-column grid and a secondary "Apply"; body scrolls inside the
  dialog; layout classes nowo-yopass-* from css/yopass.css on UiKit tokens) (REQ-UI-001 modals: native <dialog> through the UiKit `dialog` partial,
  header / body / footer). Opened by the View / Extend row actions (Action::dialogId = YopassPageFactory::PREVIEW_DIALOG_ID,
  data-nowo-ui-dialog-open) and filled by the nowo-yopass-manage-preview controller (metadata, in-browser decryption,
  access log, extend). REQ-TWIG-005: the controls are SharePreviewType fields without a name (never submitted).
  Variables: preview_form (FormView of SharePreviewType), can_extend, bundle.
#}
{% trans_default_domain 'NowoYopassBundle' %}
{% set _b = bundle|default('NowoYopassBundle') %}
{% set _body %}
    {{ form_start(preview_form, {attr: {
        class: nowo_ui_class('form', _b) ~ ' nowo-yopass-preview',
        autocomplete: 'off',
        'data-action': 'submit->nowo-yopass-manage-preview#decryptFromForm:prevent',
    }}) }}
        <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'yopass.preview.intro'|trans }}</p>

        {# Key / password: full-width input group with the dialog's only primary button attached on the right. #}
        <div class="{{ nowo_ui_class('form_row', _b) }}" data-nowo-yopass-manage-preview-target="unlock">
            <div class="nowo-yopass-input-group">
                <div class="nowo-yopass-input-group__field">
                    <div data-nowo-yopass-manage-preview-target="passwordPanel">
                        {{ form_label(preview_form.password) }}
                        {{ form_widget(preview_form.password) }}
                    </div>
                    <div hidden data-nowo-yopass-manage-preview-target="keyPanel">
                        {{ form_label(preview_form.key) }}
                        {{ form_widget(preview_form.key) }}
                    </div>
                </div>
                <button type="button" class="{{ nowo_ui_class('btn_primary', _b) }}" data-action="nowo-yopass-manage-preview#decryptFromForm" data-nowo-yopass-manage-preview-target="decryptButton">
                    {{ 'yopass.preview.decrypt'|trans }}
                </button>
            </div>
            <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'yopass.preview.key_help'|trans }}</p>
        </div>

        {# Revealed content: monospace block with Copy (text), or the download link (file). #}
        <div class="{{ nowo_ui_class('form_row', _b) }} nowo-yopass-output" hidden data-nowo-yopass-manage-preview-target="outputPanel">
            <pre class="{{ nowo_ui_class('code_block', _b) }} nowo-yopass-secret" hidden data-nowo-yopass-manage-preview-target="output"></pre>
            <div class="nowo-yopass-actions-end">
                <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-action="nowo-yopass-manage-preview#copyOutput">
                    {{ 'yopass.link.copy'|trans }}
                </button>
            </div>
        </div>
        <a href="#" class="{{ nowo_ui_class('btn_secondary', _b) }}" hidden download data-nowo-yopass-manage-preview-target="downloadLink"></a>

        {# Public link: read-only, full width, copy icon button attached. #}
        <div class="{{ nowo_ui_class('form_row', _b) }}">
            {{ form_label(preview_form.publicLink) }}
            <div class="nowo-yopass-input-group">
                <div class="nowo-yopass-input-group__field">{{ form_widget(preview_form.publicLink) }}</div>
                <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }} {{ nowo_ui_class('btn_icon', _b) }}" data-action="nowo-yopass-manage-preview#copyPublicLink" aria-label="{{ 'yopass.link.copy'|trans }}" title="{{ 'yopass.link.copy'|trans }}" data-testid="yopass-preview-copy-link">
                    {{ include('@NowoUiKitBundle/components/_icon.html.twig', {name: 'copy', label: 'yopass.link.copy'|trans}, false) }}
                </button>
            </div>
        </div>

        <div class="{{ nowo_ui_class('flash_error', _b) }}" role="alert" hidden data-nowo-yopass-manage-preview-target="error"></div>

        <section class="{{ nowo_ui_class('section', _b) }} nowo-yopass-preview__section" hidden data-nowo-yopass-manage-preview-target="accessLogPanel">
            <h3 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'yopass.preview.access_log.title'|trans }}</h3>
            <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'yopass.preview.access_log.intro'|trans }}</p>
            <p class="{{ nowo_ui_class('muted', _b) }}" hidden data-nowo-yopass-manage-preview-target="accessLogEmpty">
                {{ 'yopass.preview.access_log.empty'|trans }}
            </p>
            <div class="{{ nowo_ui_class('table_wrap', _b) }}">
                <table class="{{ nowo_ui_class('table', _b) }}" hidden data-nowo-yopass-manage-preview-target="accessLogTable">
                    <thead class="{{ nowo_ui_class('table_head', _b) }}">
                        <tr class="{{ nowo_ui_class('table_head_row', _b) }}">
                            <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }}">{{ 'yopass.preview.access_log.when'|trans }}</th>
                            <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }}">{{ 'yopass.preview.access_log.read'|trans }}</th>
                            <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }}">{{ 'yopass.preview.access_log.ip'|trans }}</th>
                            <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }}">{{ 'yopass.preview.access_log.user_agent'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody data-nowo-yopass-manage-preview-target="accessLogBody"></tbody>
                </table>
            </div>
        </section>

        {% if can_extend %}
            {# Extend: own section after a divider; the two selects side by side on desktop, stacked on phones. #}
            <section class="{{ nowo_ui_class('section', _b) }} nowo-yopass-preview__section" hidden data-nowo-yopass-manage-preview-target="extendPanel" data-testid="yopass-extend">
                <h3 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'yopass.extend.title'|trans }}</h3>
                <p class="{{ nowo_ui_class('muted', _b) }}">
                    {{ 'yopass.extend.current'|trans }}: <span data-nowo-yopass-manage-preview-target="extendSummary"></span>
                </p>
                <div class="nowo-yopass-grid-2">
                    {{ form_row(preview_form.extendExpiresIn) }}
                    {{ form_row(preview_form.extendMaxReads) }}
                </div>
                <div class="nowo-yopass-actions-end">
                    <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-action="nowo-yopass-manage-preview#submitExtend">
                        {{ 'yopass.extend.submit'|trans }}
                    </button>
                </div>
                <div class="{{ nowo_ui_class('flash_success', _b) }}" role="status" hidden data-nowo-yopass-manage-preview-target="extendSuccess"></div>
            </section>
        {% endif %}
        {% for child in preview_form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(preview_form) }}
{% endset %}
{# Status badge inline next to the title (filled by the controller). #}
{% set _title_html %}<span class="nowo-yopass-dialog-title"><span>{{ 'yopass.preview.title'|trans }}</span> <span class="{{ nowo_ui_class('badge_neutral', _b) }}" data-nowo-yopass-manage-preview-target="availability"></span></span>{% endset %}
{% set _footer %}
    <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-ui-dialog-close data-action="nowo-yopass-manage-preview#close">
        {{ 'yopass.preview.close'|trans }}
    </button>
{% endset %}
{{ include(nowo_ui_partial('dialog', _b), {
    id: constant('Nowo\\YopassBundle\\Ui\\YopassPageFactory::PREVIEW_DIALOG_ID'),
    title: 'yopass.preview.title'|trans,
    title_html: _title_html,
    body: _body,
    footer: _footer,
    size: 'wide',
    attr: {'data-nowo-yopass-manage-preview-target': 'modal', 'data-testid': 'yopass-preview', 'data-nowo-yopass-dialog': 'preview'},
    close_label: 'yopass.preview.close'|trans,
    bundle: _b,
}, with_context: false) }}
