{#
  Manage page (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from YopassPageFactory::managePage():
  header yopass.title / yopass.intro with the back link (dashboard_route) and the "Delete all" action (POST + CSRF-only
  FormView behind the UiKit confirm dialog); columns type, created, expires, reads, status; rows = list<SecureShare>;
  row actions View / Extend (open the preview <dialog>), Revoke and Delete (POST + CSRF behind the confirm dialog);
  Pagination (shares.list_page_size); EmptyState yopass.list.empty).
  Data blocks: nowo_ui_list_row (cells). nowo_ui_content prepends the create panel (manage/_create_panel.html.twig) and
  wraps the list in the preview controller with the preview dialog (manage/_preview_dialog.html.twig);
  nowo_ui_scripts stacks the bundle script after the host / UiKit scripts.
  Other variables (1.x, kept for web_ui.templates overrides and the partials): shares, shares_total, shares_page,
  shares_pages, list_page_size, can_create, can_revoke, can_extend, can_share_file, max_file_bytes, max_secret_chars,
  dashboard_route, routes, share_options, sharing_options, create_form, revoke_forms, delete_forms, delete_all_form,
  preview_form.
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoYopassBundle' %}

{% block nowo_ui_content %}
    {% set _b = page.bundle %}
    {% if can_create and create_form %}
        {{ include('@NowoYopassBundle/manage/_create_panel.html.twig', {
            create_form: create_form,
            can_share_file: can_share_file,
            max_file_bytes: max_file_bytes,
            max_secret_chars: max_secret_chars,
            bundle: _b,
        }, with_context: false) }}
    {% endif %}
    <div class="nowo-yopass-shares"
         data-controller="nowo-yopass-manage-preview"
         data-nowo-yopass-manage-preview-preview-path-template-value="{{ path(routes.preview.name, {id: '{id}'}) }}"
         data-nowo-yopass-manage-preview-allow-embed-in-url-value="{{ sharing_options.allow_embed_in_url|default(false) ? 'true' : 'false' }}"
         {% if can_extend %}
         data-nowo-yopass-manage-preview-extend-path-template-value="{{ path(routes.extend.name, {id: '{id}'}) }}"
         data-nowo-yopass-manage-preview-csrf-token-value="{{ csrf_token('yopass_extend') }}"
         data-nowo-yopass-manage-preview-extend-success-message-value="{{ 'yopass.extend.success'|trans }}"
         {% endif %}
         data-nowo-yopass-manage-preview-errors-value="{{ {
             KEY_REQUIRED: 'yopass.preview.key_required'|trans,
             PASSWORD_REQUIRED: 'yopass.public.password_required'|trans,
             INVALID_KEY: 'yopass.public.invalid_key'|trans,
             PREVIEW_FAILED: 'yopass.preview.failed'|trans,
             EXTEND_FAILED: 'yopass.extend.failed'|trans,
             revoked: 'yopass.extend.revoked'|trans,
             invalid_expiration: 'yopass.extend.invalid_expiration'|trans,
             invalid_max_reads: 'yopass.extend.invalid_max_reads'|trans,
             max_reads_not_increased: 'yopass.extend.max_reads_not_increased'|trans,
             expiration_not_extended: 'yopass.extend.expiration_not_extended'|trans,
             nothing_to_extend: 'yopass.extend.nothing_to_extend'|trans,
         }|json_encode }}"
         data-nowo-yopass-manage-preview-availability-labels-value="{{ {
             active: 'yopass.status.active'|trans,
             revoked: 'yopass.status.revoked'|trans,
             expired: 'yopass.status.unavailable'|trans,
             consumed: 'yopass.status.unavailable'|trans,
         }|json_encode }}">
        {{ parent() }}
        {{ include('@NowoYopassBundle/manage/_preview_dialog.html.twig', {
            preview_form: preview_form,
            can_extend: can_extend,
            bundle: _b,
        }, with_context: false) }}
    </div>
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    <td class="{{ _cell }}" data-label="{{ 'yopass.list.type'|trans }}" data-required="1">{{ ('yopass.type.' ~ row.payloadKind)|trans }}</td>
    <td class="{{ _cell }}" data-label="{{ 'yopass.list.created'|trans }}" data-nowo-ui-priority="2">{{ row.createdAt|date('Y-m-d H:i') }}</td>
    <td class="{{ _cell }}" data-label="{{ 'yopass.list.expires'|trans }}">{{ row.expiresAt|date('Y-m-d H:i') }}</td>
    <td class="{{ _cell }}" data-label="{{ 'yopass.list.reads'|trans }}" data-nowo-ui-priority="2">{{ row.readsLeft }} / {{ row.maxReads }}</td>
    <td class="{{ _cell }}" data-label="{{ 'yopass.list.status'|trans }}">
        {% if row.revokedAt %}
            <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ 'yopass.status.revoked'|trans }}</span>
        {% elseif row.isAvailable %}
            <span class="{{ nowo_ui_class('badge_success', _b) }}">{{ 'yopass.status.active'|trans }}</span>
        {% else %}
            <span class="{{ nowo_ui_class('badge_warning', _b) }}">{{ 'yopass.status.unavailable'|trans }}</span>
        {% endif %}
    </td>
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/yopass.js', 'nowo_yopass') }}"></script>
{% endblock %}
