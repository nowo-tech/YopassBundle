{#
    Minimal UI macros switching on nowo_yopass_css_framework / nowo_yopass_icon_set (REQ-UI-001).
    Import: {% import '@NowoYopassBundle/_ui_macros.html.twig' as nowo_ui %}
#}

{% macro btn(variant, size, extra) %}
    {% set framework = nowo_yopass_css_framework|default('tabler') %}
    {% if framework in ['bootstrap', 'bootstrap4', 'bootstrap5', 'tabler'] %}
        btn btn-{{ variant|default('primary') }}{% if size %} btn-{{ size }}{% endif %}{{ extra|default('') }}
    {% elseif framework == 'tailwind' %}
        inline-flex items-center rounded px-3 py-2 text-sm font-medium nowo-ui-btn nowo-ui-btn-{{ variant|default('primary') }}{{ extra|default('') }}
    {% elseif framework == 'foundation' %}
        button nowo-ui-btn nowo-ui-btn-{{ variant|default('primary') }}{{ extra|default('') }}
    {% else %}
        nowo-ui-btn nowo-ui-btn-{{ variant|default('primary') }}{{ extra|default('') }}
    {% endif %}
{% endmacro %}

{% macro btn_icon(variant, size) %}
    {{ _self.btn(variant|default('outline-primary'), size|default('sm'), ' btn-icon') }}
{% endmacro %}

{% macro alert(type) %}
    {% set framework = nowo_yopass_css_framework|default('tabler') %}
    {% if framework in ['bootstrap', 'bootstrap4', 'bootstrap5', 'tabler'] %}
        alert alert-{{ type|default('info') }} nowo-ui-alert
    {% elseif framework == 'tailwind' %}
        rounded border px-4 py-3 nowo-ui-alert nowo-ui-alert-{{ type|default('info') }}
    {% elseif framework == 'foundation' %}
        callout nowo-ui-alert nowo-ui-alert-{{ type|default('info') }}
    {% else %}
        nowo-ui-alert nowo-ui-alert-{{ type|default('info') }}
    {% endif %}
{% endmacro %}

{% macro page_header() %}
    {% set framework = nowo_yopass_css_framework|default('tabler') %}
    {% if framework in ['bootstrap', 'bootstrap4', 'bootstrap5', 'tabler'] %}
        page-header d-print-none mb-4 nowo-ui-page-header
    {% elseif framework == 'tailwind' %}
        mb-6 border-b pb-4 nowo-ui-page-header
    {% elseif framework == 'foundation' %}
        nowo-ui-page-header margin-bottom-2
    {% else %}
        nowo-ui-page-header
    {% endif %}
{% endmacro %}

{% macro card() %}
    {% set framework = nowo_yopass_css_framework|default('tabler') %}
    {% if framework in ['bootstrap', 'bootstrap4', 'bootstrap5', 'tabler'] %}
        card nowo-ui-card
    {% elseif framework == 'tailwind' %}
        rounded-lg border bg-white shadow-sm nowo-ui-card
    {% elseif framework == 'foundation' %}
        card nowo-ui-card
    {% else %}
        nowo-ui-card
    {% endif %}
{% endmacro %}

{% macro table() %}
    {% set framework = nowo_yopass_css_framework|default('tabler') %}
    {% if framework in ['bootstrap', 'bootstrap4', 'bootstrap5', 'tabler'] %}
        table table-vcenter card-table mb-0 nowo-ui-table
    {% elseif framework == 'tailwind' %}
        min-w-full divide-y nowo-ui-table
    {% elseif framework == 'foundation' %}
        table nowo-ui-table
    {% else %}
        nowo-ui-table
    {% endif %}
{% endmacro %}

{% macro toolbar() %}
    btn-list flex-nowrap justify-content-end nowo-ui-toolbar nowo-ui-actions
{% endmacro %}

{#
    Semantic action icons (view / extend / revoke / delete / delete_all).
    Maps to Tabler or Bootstrap Icons depending on nowo_yopass_icon_set.
#}
{% macro action_icon(action, extra_class) %}
    {% set icons = nowo_yopass_icon_set|default('tabler-icons') %}
    {% set tabler = {
        'view': 'eye',
        'extend': 'clock-plus',
        'revoke': 'ban',
        'delete': 'trash',
        'delete_all': 'trash-x',
    } %}
    {% set bootstrap = {
        'view': 'eye',
        'extend': 'clock-history',
        'revoke': 'slash-circle',
        'delete': 'trash',
        'delete_all': 'trash2',
    } %}
    {% set spacer = extra_class|default('') %}
    {% if icons == 'none' %}
    {% elseif icons == 'bootstrap-icons' %}
        <i class="bi bi-{{ bootstrap[action]|default(action) }}{{ spacer }}" aria-hidden="true"></i>
    {% else %}
        <i class="ti ti-{{ tabler[action]|default(action) }}{{ spacer }}" aria-hidden="true"></i>
    {% endif %}
{% endmacro %}
