{#
  Public reveal page (REQ-UI-003 unique page, declared in docs/TEMPLATES.md): the recipient's page, not an admin screen.
  Extends web_ui.public_layout_template (page_layout), else the UiKit guest layout (nowo_ui_layout.guest), and fills
  the canonical blocks. The ciphertext is fetched (one read) and decrypted in the browser by the nowo-share-reveal
  controller; the key / password comes from the URL fragment or the form and is never sent to the server
  (REQ-SEC-004 M1). REQ-TWIG-005: ShareRevealType renders the password (password mode) or key (key mode) input
  without a name (never submitted).
  Variables: header (View\PageHeader), page_layout (?string), share (SecureShare), decryption_mode (key|password),
  routes, reveal_form (FormView of ShareRevealType).
#}
{% extends page_layout ?? nowo_ui_layout.guest %}
{% trans_default_domain 'NowoYopassBundle' %}
{% set nowo_ui_bundle = 'NowoYopassBundle' %}
{% set nowo_ui_page_type = 'form' %}

{% block nowo_ui_document_title %}{{ header.title|nowo_ui_trans }}{% endblock %}

{% block nowo_ui_page_header %}{{ nowo_ui_page_header(header, nowo_ui_bundle) }}{% endblock %}

{% block nowo_ui_content %}
    {% set _b = nowo_ui_bundle %}
    <section class="{{ nowo_ui_class('form_panel', _b) }} nowo-yopass-reveal" data-testid="yopass-reveal"{{ nowo_ui_attrs('form_panel', _b) }}
             data-controller="nowo-share-reveal"
             data-nowo-share-reveal-consume-url-value="{{ path(routes.public_consume.name, {id: share.id}) }}"
             data-nowo-share-reveal-share-id-value="{{ share.id }}"
             data-nowo-share-reveal-mode-value="{{ decryption_mode }}"
             data-nowo-share-reveal-errors-value="{{ {
                 KEY_REQUIRED: 'yopass.public.key_required'|trans,
                 PASSWORD_REQUIRED: 'yopass.public.password_required'|trans,
                 INVALID_KEY: 'yopass.public.invalid_key'|trans,
                 expired: 'yopass.public.unavailable'|trans,
                 revoked: 'yopass.public.unavailable'|trans,
                 consumed: 'yopass.public.unavailable'|trans,
             }|json_encode }}">
        {% if not share.isAvailable %}
            <div class="{{ nowo_ui_class('flash_warning', _b) }}" role="status">{{ 'yopass.public.unavailable'|trans }}</div>
        {% else %}
            <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'yopass.public.e2e_notice'|trans }}</p>

            {% if decryption_mode == 'password' %}
                <p class="{{ nowo_ui_class('muted', _b) }}" hidden data-nowo-share-reveal-target="passwordFromLinkHint">
                    {{ 'yopass.public.password_from_link'|trans }}
                </p>
            {% else %}
                <p class="{{ nowo_ui_class('muted', _b) }}" hidden data-nowo-share-reveal-target="keyFromLinkHint">
                    {{ 'yopass.public.key_from_link'|trans }}
                </p>
            {% endif %}

            {{ form_start(reveal_form, {attr: {
                class: nowo_ui_class('form', _b),
                autocomplete: 'off',
                'data-action': 'submit->nowo-share-reveal#reveal:prevent',
            }}) }}
                {% for child in reveal_form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                <div class="{{ nowo_ui_class('form_actions', _b) }}"{{ nowo_ui_attrs('form_actions', _b) }}>
                    <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}" data-nowo-share-reveal-target="revealButton">
                        {{ 'yopass.public.reveal'|trans }}
                    </button>
                </div>
            {{ form_end(reveal_form) }}

            <pre class="{{ nowo_ui_class('code_block', _b) }} nowo-yopass-secret" hidden data-nowo-share-reveal-target="output"></pre>
            <a href="#" class="{{ nowo_ui_class('btn_primary', _b) }}" hidden download data-nowo-share-reveal-target="downloadLink"></a>
            <div class="{{ nowo_ui_class('flash_error', _b) }}" role="alert" hidden data-nowo-share-reveal-target="error"></div>
        {% endif %}
    </section>
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/yopass.js', 'nowo_yopass') }}"></script>
{% endblock %}
