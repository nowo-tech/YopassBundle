<?xml version="1.0" encoding="UTF-8"?>
<!--
    XML mapping of ShareAccessLog (1.19.0, REQ-ARCH-001 rule 2), used with nowo_yopass.database.mapping: xml and the
    bundle's ORM access log. Same table and columns as the attribute mapping; SecureShareMetadataListener applies the
    table name (table_prefix) and the share_ref index.
-->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\YopassBundle\Entity\ShareAccessLog" table="yopass_share_access_logs">
        <id name="id" type="string" length="36"/>
        <field name="accessedAt" column="accessed_at" type="datetime_immutable"/>
        <field name="shareRef" column="share_ref" type="string" length="64" nullable="true">
            <options>
                <option name="fixed">true</option>
            </options>
        </field>
        <field name="readNumber" column="read_number" type="integer"/>
        <field name="ipAddress" column="ip_address" type="string" length="45" nullable="true"/>
        <field name="userAgent" column="user_agent" type="string" length="512" nullable="true"/>
        <many-to-one field="share" target-entity="Nowo\YopassBundle\Entity\SecureShare">
            <join-column name="share_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
